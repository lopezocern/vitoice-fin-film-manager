# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Dev data (isolated dev database + generated assets)
backend/data/

# Node / Frontend
node_modules/
dist/
frontend/dist/

# Tauri / Rust
src-tauri/target/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Env
# .env.production 是有意纳入版本库的构建默认配置（只含 localhost 端口，无密钥），单独放行。
.env
.env.*
!.env.production

# 编辑器/手工备份残留
*.bak
*.orig

# Smoke test databases
backend/_smoke*.db

# Databases & logs anywhere in the repo
*.db
*.db-wal
*.db-shm
*.log

# WorkBuddy agent workspace (local memory/automations, not source code)
.workbuddy/

# Tool temp/share artifacts
.tmp/
.reasonix/
.trae-html-share-packages/

# Frontend build artifacts
frontend/.svelte-kit/
frontend/build/
frontend/vite.config.ts.timestamp-*.mjs

# Tauri generated schemas
src-tauri/gen/

# PyInstaller build artifacts (rebuild via: cd backend && python -m PyInstaller vitoice-backend.spec,
# then copy dist/vitoice-backend -> src-tauri/resources/backend/ before `tauri build`)
backend/build/
src-tauri/resources/backend/

# Local scripts containing private API keys (never commit)
generate_image_makabaka.ps1
*.local.ps1
*.key
*.pem

# Bundled ffmpeg binaries (too large for git, installed via script or manually)
# Keep the directory but ignore the executables
backend/bin/*.exe
backend/bin/*.dll
backend/bin/*.so
backend/bin/*.dylib
