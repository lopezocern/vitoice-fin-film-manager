/* ---- 本地字体（通过 @fontsource 包，离线可用，无外部依赖） ---- */
@import '@fontsource/plus-jakarta-sans/400.css';
@import '@fontsource/plus-jakarta-sans/500.css';
@import '@fontsource/plus-jakarta-sans/600.css';
@import '@fontsource/plus-jakarta-sans/700.css';
@import '@fontsource/plus-jakarta-sans/800.css';
@import '@fontsource/inter/400.css';
@import '@fontsource/inter/500.css';
@import '@fontsource/inter/600.css';
@import '@fontsource/jetbrains-mono/400.css';
@import '@fontsource/jetbrains-mono/500.css';

@tailwind base;
@tailwind components;
@tailwind utilities;

/* ═══════════════════════════════════════════════════════════════
   vitoice 3.0 — 全局样式
   字体：Plus Jakarta Sans (display) + Inter (body) + JetBrains Mono (code)
   主题：自动跟随系统，默认深色
   ═══════════════════════════════════════════════════════════════ */

/* ---- 深色主题（默认） ---- */
:root {
  /* 背景层次：从深到浅 */
  --bg: #0d0d10;
  --bg-elevated: #151519;
  --bg-surface: #1c1c22;
  --bg-hover: #25252c;
  --bg-active: #2d2d36;

  /* 别名：组件中广泛使用的 --bg2 / --bg-soft 映射到已定义的层次 */
  --bg2: var(--bg-elevated);
  --bg-soft: var(--bg-hover);

  /* 文字层次 */
  --ink: #f0f0f3;
  --ink-secondary: #a8a8b3;
  --ink-tertiary: #6b6b76;
  --ink-faint: #45454f;

  /* 边框 / 分割线 */
  --rule: #25252c;
  --rule-light: #1e1e24;

  /* 强调色 — indigo */
  --accent: #7b73ff;
  --accent-hover: #8d87ff;
  --accent-soft: rgba(123, 115, 255, 0.12);
  --accent-glow: rgba(123, 115, 255, 0.25);

  /* 次强调色 — amber */
  --accent2: #f5a623;
  --accent2-soft: rgba(245, 166, 35, 0.12);

  /* 语义色 */
  --ok: #34d399;
  --ok-soft: rgba(52, 211, 153, 0.12);
  --warn: #fbbf24;
  --danger: #f87171;
  --danger-soft: rgba(248, 113, 113, 0.12);

  /* 中性 */
  --neutral: #6b6b76;

  /* 圆角 */
  --radius-xs: 4px;
  --radius-sm: 6px;
  --radius: 8px;
  --radius-md: 10px;
  --radius-lg: 14px;
  --radius-xl: 20px;
  --radius-full: 999px;

  /* 阴影 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
  --shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.4);
  --shadow-glow: 0 0 20px var(--accent-glow);

  /* 字体族 */
  --font-display: 'Plus Jakarta Sans', -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --font-body: 'Inter', -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --font-mono: 'JetBrains Mono', 'Cascadia Code', 'Consolas', monospace;

  /* 动效 */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --dur-fast: 120ms;
  --dur: 200ms;
  --dur-slow: 350ms;

  /* 布局 */
  --topnav-h: 52px;
  --sidebar-w: 220px;
  --sidebar-collapsed-w: 52px;
}

/* ---- 浅色主题变量集（命名复用，通过选择器切换） ---- */
/* 强制浅色：data-theme="light" */
[data-theme='light'] {
  --bg: #fafafb;
  --bg-elevated: #ffffff;
  --bg-surface: #f5f5f7;
  --bg-hover: #eeeef1;
  --bg-active: #e5e5ea;

  --bg2: var(--bg-elevated);
  --bg-soft: var(--bg-hover);

  --ink: #1a1a1f;
  --ink-secondary: #55555f;
  --ink-tertiary: #868692;
  --ink-faint: #b0b0b8;

  --rule: #e0e0e5;
  --rule-light: #ededf0;

  --accent: #635bff;
  --accent-hover: #5a4ee6;
  --accent-soft: rgba(99, 91, 255, 0.08);
  --accent-glow: rgba(99, 91, 255, 0.15);

  --accent2: #e89000;
  --accent2-soft: rgba(232, 144, 0, 0.10);

  --ok: #16a34a;
  --warn: #d97706;
  --danger: #dc2626;
  --danger-soft: rgba(220, 38, 38, 0.08);

  --neutral: #868692;

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
  --shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.10);
}

/* 跟随系统：data-theme="system" 或未设置时，按 prefers-color-scheme 切换 */
@media (prefers-color-scheme: light) {
  :root:not([data-theme='dark']):not([data-theme='light']) {
    --bg: #fafafb;
    --bg-elevated: #ffffff;
    --bg-surface: #f5f5f7;
    --bg-hover: #eeeef1;
    --bg-active: #e5e5ea;

    --bg2: var(--bg-elevated);
    --bg-soft: var(--bg-hover);

    --ink: #1a1a1f;
    --ink-secondary: #55555f;
    --ink-tertiary: #868692;
    --ink-faint: #b0b0b8;

    --rule: #e0e0e5;
    --rule-light: #ededf0;

    --accent: #635bff;
    --accent-hover: #5a4ee6;
    --accent-soft: rgba(99, 91, 255, 0.08);
    --accent-glow: rgba(99, 91, 255, 0.15);

    --accent2: #e89000;
    --accent2-soft: rgba(232, 144, 0, 0.10);

    --ok: #16a34a;
    --warn: #d97706;
    --danger: #dc2626;
    --danger-soft: rgba(220, 38, 38, 0.08);

    --neutral: #868692;

    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.04);
    --shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.08);
    --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.10);
  }
}

/* 强制深色：data-theme="dark" */
[data-theme='dark'] {
  --bg: #0d0d10;
  --bg-elevated: #151519;
  --bg-surface: #1c1c22;
  --bg-hover: #25252c;
  --bg-active: #2d2d36;
  --bg2: var(--bg-elevated);
  --bg-soft: var(--bg-hover);
  --ink: #f0f0f3;
  --ink-secondary: #a8a8b3;
  --ink-tertiary: #6b6b76;
  --ink-faint: #45454f;
  --rule: #25252c;
  --rule-light: #1e1e24;
  --accent: #7b73ff;
  --accent-hover: #8d87ff;
  --accent-soft: rgba(123, 115, 255, 0.12);
  --accent-glow: rgba(123, 115, 255, 0.25);
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
  --shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.4);
}

/* ---- 基础重置 ---- */
* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  height: 100%;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 450;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  transition: background var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: -0.02em;
}

button {
  font-family: inherit;
  cursor: pointer;
  border: none;
  background: none;
  color: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

input, select, textarea {
  font-family: inherit;
}

code, pre {
  font-family: var(--font-mono);
}

/* ---- 滚动条 ---- */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--rule);
  border-radius: var(--radius-full);
}

::-webkit-scrollbar-thumb:hover {
  background: var(--ink-tertiary);
}

/* ---- 文本选区 ---- */
::selection {
  background: var(--accent-soft);
  color: var(--accent);
}

/* ---- 全局动画关键帧 ---- */
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slide-up {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slide-in-right {
  from { opacity: 0; transform: translateX(-12px); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes scale-in {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 0 0 var(--accent-glow); }
  50% { box-shadow: 0 0 0 4px transparent; }
}

/* ---- 工具类 ---- */
.anim-fade-in { animation: fade-in var(--dur) var(--ease-out); }
.anim-slide-up { animation: slide-up var(--dur) var(--ease-out); }
.anim-scale-in { animation: scale-in var(--dur) var(--ease-spring); }

/* 骨架屏 shimmer 效果 */
.skeleton {
  background: linear-gradient(
    90deg,
    var(--bg-surface) 0%,
    var(--bg-hover) 50%,
    var(--bg-surface) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

/* 玻璃毛玻璃效果 */
.glass {
  background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
  backdrop-filter: blur(16px) saturate(180%);
  -webkit-backdrop-filter: blur(16px) saturate(180%);
}

/* 聚焦环 */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* 去除焦点轮廓（鼠标点击时） */
:focus:not(:focus-visible) {
  outline: none;
}
